#, python-format
msgid "+%(counter)s more date"
msgid_plural "+%(counter)s more dates"
msgstr[0] "+%(counter)s andere datum"
msgstr[1] "+%(counter)s andere data"

#: templates/events/event_list.html:82
msgid "Add these events to your calendar"
msgstr "Voeg deze evenementen toe aan jouw kalender"

#: views.py:98
msgid "This event does not have registrations."
msgstr "Voor dit evenement kun je je niet registreren."

#: views.py:102
msgid "The registrations for this event have not opened yet."
msgstr "De registraties voor dit evenement zijn nog niet geopend."

#: views.py:107
msgid "The registrations for this event have already closed."
msgstr "De registraties voor dit evenement zijn al gesloten."

#: views.py:110
msgid "You have already registered for this event."
msgstr "Je bent al geregistreerd voor dit evenement."

#: views.py:112
msgid "This event is already full."
msgstr "Dit evenement zit vol."

#: views.py:120
msgid "You successfully registered."
msgstr "Je bent succesvol geregistreerd."

#: views.py:141
msgid "Register for the event before filling in the form."
msgstr "Registreer je voor het evenement voordat je het formulier invult."

#: views.py:181
msgid ""
"We have not received your form yet. Fill in all questions and press the "
"submit button at the end of the form, then try again. If it still does not "
"work, contact the committee."
msgstr ""
"We hebben je formulier nog niet ontvangen. Vul alle vragen in en druk op de "
"verzendknop aan het eind van het formulier, en probeer het dan opnieuw. Werkt"
" het nog steeds niet, neem dan contact op met de commissie."

#: views.py:190
msgid "Thank you, your registration is complete."
msgstr "Bedankt, je registratie is compleet."

#: views.py:204
msgid "You are not registered for this event."
msgstr "Je bent niet geregistreerd voor dit evenement."

#: views.py:209
msgid ""
"The registrations for this event have already closed, if you still want to "
"deregister contact the committee."
msgstr ""
"De registraties voor dit evenement zijn al gesloten, als je je nog wil "
"uitschrijven, contacteer de commissie."

#: views.py:215
msgid "You successfully unregistered."
msgstr "Je bent succesvol afgemeld."

#: views.py:248
msgid "For more details, see the website: "
msgstr "Voor meer details, zie de website: "
