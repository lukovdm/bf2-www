#: form_sync.py:40
#, python-format
msgid ""
"The form is not shared with %(email)s. Share the form with this address as "
"editor in Google Forms."
msgstr ""
"Het formulier is niet gedeeld met %(email)s. Deel het formulier met dit adres"
" als bewerker in Google Forms."

#: form_sync.py:102
msgid "This event has no form."
msgstr "Dit evenement heeft geen formulier."

#: form_sync.py:105
msgid ""
"The Google Forms connection of the website is not set up, members confirm "
"themselves that they filled in the form."
msgstr ""
"De Google Forms koppeling van de website is niet ingesteld, leden bevestigen "
"zelf dat ze het formulier hebben ingevuld."

#: form_sync.py:109
msgid "Connected: the website checks which members filled in the form."
msgstr ""
"Gekoppeld: de website controleert welke leden het formulier hebben ingevuld."

#: form_sync.py:111
#, python-format
msgid "Last check failed: %(error)s"
msgstr "Laatste controle mislukt: %(error)s"

#: form_sync.py:116
#, python-format
msgid "Not connected: %(error)s"
msgstr "Niet gekoppeld: %(error)s"

#: form_sync.py:118
#, python-format
msgid ""
"Not connected yet. Share the form with %(email)s as editor in Google Forms "
"and save the event."
msgstr ""
"Nog niet gekoppeld. Deel het formulier met %(email)s als bewerker in Google "
"Forms en sla het evenement op."

#: models.py:58
msgid "name"
msgstr "naam"

#: models.py:60
msgid "image"
msgstr "foto"

#: models.py:62 models.py:264
msgid "location"
msgstr "locatie"

#: models.py:65
msgid "hidden"
msgstr "verborgen"

#: models.py:67
msgid "Hidden events are not shown anywhere on the website, only in the admin."
msgstr ""
"Verborgen evenementen worden nergens op de website getoond, alleen in de "
"admin."

#: models.py:72
msgid "participant limit"
msgstr "deelnemerslimiet"

#: models.py:74
msgid "Don't show who is registered"
msgstr "Laat niet zien wie is geregistreerd"

#: models.py:81
msgid "cost"
msgstr "kosten"

#: models.py:82
msgid "Leave empty for a free event."
msgstr "Laat leeg voor een gratis evenement."

#: models.py:88
msgid "registration start"
msgstr "start registratie"

#: models.py:90
msgid ""
"When the registration opens, by default now. Leave the registration start and"
" end empty for an event without registration."
msgstr ""
"Wanneer de registratie opent, standaard nu. Laat de registratie start en eind"
" leeg voor een evenement zonder registratie."

#: models.py:97
msgid "registration end"
msgstr "einde registratie"

#: models.py:99
msgid ""
"When the registration closes. Leave empty to close the registration when the "
"event starts."
msgstr ""
"Wanneer de registratie sluit. Laat leeg om de registratie te sluiten als het "
"evenement begint."

#: models.py:108
msgid "Google form link"
msgstr "Google form link"

#: models.py:112
msgid "Please enter a google form share link"
msgstr "Vul a.u.b. een google form deel link in"

#: models.py:205
msgid "A registration end requires a registration start."
msgstr "Een registratie eind heeft een registratie start nodig."

#: models.py:214
msgid "Registration start must be before registration end."
msgstr "De registratie start moet voor het registratie eind zijn."

#: models.py:221
msgid "The participant limit must be at least 1, leave it empty for no limit."
msgstr ""
"Het deelnemerslimiet moet minimaal 1 zijn, laat het leeg voor geen limiet."

#: models.py:251
msgid "show end"
msgstr "laat eind zien"

#: models.py:257
msgid "label"
msgstr "label"

#: models.py:258
msgid "Optional, e.g. 'Day 1' or 'Finals'."
msgstr "Optioneel, bijvoorbeeld 'Dag 1' of 'Finales'."

#: models.py:265
msgid "Leave empty to use the location of the event."
msgstr "Laat leeg om de locatie van het evenement te gebruiken."

#: models.py:270
msgid "date"
msgstr "datum"

#: models.py:285 models.py:286
msgid "The start must be before the end."
msgstr "De start moet voor het eind zijn."

#: models.py:305
msgid "user"
msgstr "gebruiker"

#: models.py:316
msgid "not filled in"
msgstr "niet ingevuld"

#: models.py:317
msgid "filled in (checked with Google)"
msgstr "ingevuld (gecontroleerd bij Google)"

#: models.py:318
msgid "filled in (according to the member)"
msgstr "ingevuld (volgens het lid)"

#: models.py:319
msgid "filled in (marked by an admin)"
msgstr "ingevuld (aangegeven door een admin)"

#: models.py:322
msgid "filled in according to the member, but not found at Google"
msgstr "ingevuld volgens het lid, maar niet gevonden bij Google"

#: models.py:341
msgid "form filled in at"
msgstr "formulier ingevuld op"

#: templates/admin/events/event/change_form.html:11
msgid "Export registrations"
msgstr "Exporteer registraties"

#: templates/events/event_detail.html:26
msgid "Edit in admin"
msgstr "Bewerk in admin"

#: templates/events/event_detail.html:34
msgid ""
"This event is hidden, only people who manage events can see it on the "
"website."
msgstr ""
"Dit evenement is verborgen, alleen mensen die evenementen beheren kunnen het "
"op de website zien."

#: templates/events/event_detail.html:51
#, python-format
msgid "%(counter)s date"
msgid_plural "%(counter)s dates"
msgstr[0] "%(counter)s datum"
msgstr[1] "%(counter)s data"

#: templates/events/event_detail.html:72
msgid "free"
msgstr "gratis"

#: templates/events/event_detail.html:93
msgid "ended"
msgstr "afgelopen"

#: templates/events/event_detail.html:110
msgid "Your registration is not complete:"
msgstr "Je registratie is niet compleet:"

#: templates/events/event_detail.html:111
msgid "you still need to fill in the form."
msgstr "je moet het formulier nog invullen."

#: templates/events/event_detail.html:114
msgid "Fill in the form"
msgstr "Vul het formulier in"

#: templates/events/event_detail.html:121 templates/events/event_form.html:17
msgid "We could not find your form at Google."
msgstr "We konden je formulier niet vinden bij Google."

#: templates/events/event_detail.html:122
msgid "If you did not submit it, please fill it in again."
msgstr "Als je het niet hebt verzonden, vul het dan opnieuw in."

#: templates/events/event_detail.html:125
msgid "Check the form"
msgstr "Controleer het formulier"

#: templates/events/event_detail.html:130
msgid "You are registered and filled in the form."
msgstr "Je bent geregistreerd en hebt het formulier ingevuld."

#: templates/events/event_detail.html:137
msgid "Deregistration is closed, contact the committee"
msgstr "Uitschrijven is gesloten, contacteer de commissie"

#: templates/events/event_detail.html:139
msgid "unregister"
msgstr "afmelden"

#: templates/events/event_detail.html:144
msgid "Change form"
msgstr "Verander formulier"

#: templates/events/event_detail.html:153
msgid "Full"
msgstr "Vol"

#: templates/events/event_detail.html:155
msgid "Not opened"
msgstr "Niet geopend"

#: templates/events/event_detail.html:157
msgid "Closed"
msgstr "Gesloten"

#: templates/events/event_detail.html:159
msgid "register"
msgstr "registreren"

#: templates/events/event_detail.html:169
msgid "registrations open at"
msgstr "registratie opent op"

#: templates/events/event_detail.html:174
msgid "registrations close at"
msgstr "registratie sluit op"

#: templates/events/event_form.html:4 templates/events/event_form.html:5
#: templates/events/event_form.html:28
msgid "form for"
msgstr "form voor"

#: templates/events/event_form.html:11
msgid "Your registration is not complete yet."
msgstr "Je registratie is nog niet compleet."

#: templates/events/event_form.html:12
msgid ""
"Fill in the form below and press the submit button at the end of the form. "
"Then confirm with the button below the form."
msgstr ""
"Vul het formulier hieronder in en druk op de verzendknop aan het eind van het"
" formulier. Bevestig daarna met de knop onder het formulier."

#: templates/events/event_form.html:18
msgid ""
"You said you submitted it, so your registration counts as complete. If you "
"did not submit it, fill in the form below and check again."
msgstr ""
"Je gaf aan dat je het hebt verzonden, dus je registratie telt als compleet. "
"Als je het niet hebt verzonden, vul het formulier hieronder in en controleer "
"opnieuw."

#: templates/events/event_form.html:22
msgid "You already filled in the form, you can change your answers below."
msgstr ""
"Je hebt het formulier al ingevuld, hieronder kun je je antwoorden aanpassen."

#: templates/events/event_form.html:28
msgid "Loading..."
msgstr "Laden..."

#: templates/events/event_form.html:37
msgid "We have not received your form yet."
msgstr "We hebben je formulier nog niet ontvangen."

#: templates/events/event_form.html:38
msgid ""
"Make sure you pressed the submit button at the end of the form and saw the "
"confirmation of Google, then check again. Sometimes it takes a minute before "
"we see your answers."
msgstr ""
"Controleer of je op de verzendknop aan het eind van het formulier hebt "
"gedrukt en de bevestiging van Google hebt gezien, en controleer dan opnieuw. "
"Soms duurt het even voordat we je antwoorden zien."

#: templates/events/event_form.html:41
msgid ""
"Are you sure you submitted the form? Then you can still complete your "
"registration, the committee will see that we could not check your form."
msgstr ""
"Weet je zeker dat je het formulier hebt verzonden? Dan kun je je registratie "
"toch afronden, de commissie ziet dan dat we je formulier niet konden "
"controleren."

#: templates/events/event_form.html:45 templates/events/event_form.html:52
msgid "Check again"
msgstr "Opnieuw controleren"

#: templates/events/event_form.html:48
msgid "I am sure I submitted the form"
msgstr "Ik weet zeker dat ik het formulier heb verzonden"

#: templates/events/event_form.html:56
msgid "I submitted the form"
msgstr "Ik heb het formulier verzonden"

#: templates/events/event_form.html:59
msgid "This button works after you submitted the form above."
msgstr "Deze knop werkt nadat je het formulier hierboven hebt verzonden."

#: templates/events/event_form.html:63
msgid "Fill in later"
msgstr "Later invullen"

#: templates/events/event_form.html:63 templates/events/event_form.html:94
msgid "Back to the event"
msgstr "Terug naar het evenement"

#: templates/events/event_form.html:65
msgid "your registration stays incomplete until you filled in the form"
msgstr "je registratie blijft onvolledig tot je het formulier hebt ingevuld"

#: templates/events/event_list.html:5
msgid "Events"
msgstr "Evenementen"

#: templates/events/event_list.html:22
msgid "Hidden"
msgstr "Verborgen"

#: templates/events/event_list.html:27
msgid "Form not filled in"
msgstr "Formulier niet ingevuld"

#: templates/events/event_list.html:31
msgid "Form not found"
msgstr "Formulier niet gevonden"

